<%= form_with model: castle do |f| %><% if castle.errors.any? %><div class="alert alert-danger" role="alert"><h2 class="h5">Перевір дані</h2><ul class="mb-0"><% castle.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
<div class="mb-3"><%= f.label :name, "Назва замку", class: "form-label" %><%= f.text_field :name, class: "form-control", required: true, maxlength: 150 %></div>
<div class="row"><div class="col-md-6 mb-3"><%= f.label :region, "Область", class: "form-label" %><%= f.text_field :region, class: "form-control", required: true, maxlength: 150 %></div><div class="col-md-6 mb-3"><%= f.label :location, "Населений пункт", class: "form-label" %><%= f.text_field :location, class: "form-control", required: true, maxlength: 150 %></div></div>
<div class="mb-3"><%= f.label :built_year, "Рік заснування (необов’язково)", class: "form-label" %><%= f.number_field :built_year, class: "form-control", min: 1, max: Date.current.year %></div>
<div class="mb-4"><%= f.label :description, "Історія та опис", class: "form-label" %><%= f.text_area :description, class: "form-control", rows: 7, required: true, maxlength: 10000 %></div><%= f.submit "Зберегти замок", class: "btn btn-primary" %> <%= link_to "Скасувати", castles_path, class: "btn btn-outline-secondary" %><% end %>