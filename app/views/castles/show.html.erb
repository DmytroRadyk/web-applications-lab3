<% content_for :title, @castle.name %><div class="container py-4"><%= link_to "← До колекції", castles_path %><div class="detail-cover mt-4 mb-4" aria-hidden="true"></div><div class="row g-4"><div class="col-lg-8"><article class="paper"><p class="eyebrow"><%= @castle.region %></p><h1 class="section-title"><%= @castle.name %></h1><p class="text-secondary"><%= @castle.location %><% if @castle.built_year %> · Рік заснування: <%= @castle.built_year %><% end %></p><div class="prose"><%= @castle.description %></div></article></div><aside class="col-lg-4"><div class="paper"><h2 class="h5">Про запис</h2><p>Додав: <%= @castle.user.email.split('@').first %></p><p class="text-secondary">Оновлено <%= @castle.updated_at.strftime("%d.%m.%Y") %></p><% if current_user == @castle.user %><%= link_to "Редагувати", edit_castle_path(@castle), class: "btn btn-primary" %><%= button_to "Видалити запис", @castle, method: :delete, class: "btn btn-outline-danger mt-3" %><% else %><p class="small text-secondary">Редагувати цей запис може його автор.</p><% end %></div></aside></div></div>