<article class="castle-card rounded-4" id="<%= dom_id castle %>"><div class="castle-cover" aria-hidden="true"><span class="badge"><%= castle.region %></span></div><div class="p-4"><p class="eyebrow"><%= castle.location %></p><h2><%= link_to castle.name, castle %></h2><p class="card-description"><%= truncate castle.description, length: 130 %></p><%= link_to "Відкрити історію →", castle, class: "fw-semibold" %></div></article>