<div class="container"><section class="paper auth-card"><p class="eyebrow">Раді знову бачити</p><h1>Увійти</h1><p class="text-secondary">Продовжуй збирати свою колекцію.</p><%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %><div class="mb-3"><%= f.label :email, "Електронна пошта", class: "form-label" %><%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "form-control" %></div><div class="mb-3"><%= f.label :password, "Пароль", class: "form-label" %><%= f.password_field :password, autocomplete: "current-password", required: true, class: "form-control" %></div><div class="form-check mb-3"><%= f.check_box :remember_me, class: "form-check-input" %><%= f.label :remember_me, "Запам’ятати мене", class: "form-check-label" %></div><%= f.submit "Увійти", class: "btn btn-primary w-100" %><% end %><p class="mt-4 mb-1"><%= link_to "Створити акаунт", new_registration_path(resource_name) %></p><%= link_to "Забули пароль?", new_password_path(resource_name) %></section></div>