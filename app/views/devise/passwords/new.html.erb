<div class="container"><section class="paper auth-card"><h1>Відновити пароль</h1><%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %><%= render "devise/shared/error_messages", resource: resource %><div class="mb-4"><%= f.label :email, "Електронна пошта", class: "form-label" %><%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "form-control" %></div><%= f.submit "Надіслати інструкцію", class: "btn btn-primary" %><% end %><p class="mt-4"><%= link_to "До входу", new_session_path(resource_name) %></p></section></div>