<div class="container"><section class="paper auth-card"><h1>Новий пароль</h1><%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %><%= render "devise/shared/error_messages", resource: resource %><%= f.hidden_field :reset_password_token %><div class="mb-3"><%= f.label :password, "Новий пароль", class: "form-label" %><%= f.password_field :password, autocomplete: "new-password", required: true, minlength: 8, class: "form-control" %></div><div class="mb-4"><%= f.label :password_confirmation, "Повтори пароль", class: "form-label" %><%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "form-control" %></div><%= f.submit "Змінити пароль", class: "btn btn-primary" %><% end %></section></div>