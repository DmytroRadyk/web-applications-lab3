<div class="container"><section class="paper auth-card"><p class="eyebrow">Почни власну колекцію</p><h1>Створити акаунт</h1><p class="text-secondary">Додавай місця, які варто відкрити іншим.</p><%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %><%= render "devise/shared/error_messages", resource: resource %><div class="mb-3"><%= f.label :email, "Електронна пошта", class: "form-label" %><%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "form-control" %></div><div class="mb-3"><%= f.label :password, "Пароль (мінімум 8 символів)", class: "form-label" %><%= f.password_field :password, autocomplete: "new-password", required: true, minlength: 8, class: "form-control" %></div><div class="mb-4"><%= f.label :password_confirmation, "Повтори пароль", class: "form-label" %><%= f.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "form-control" %></div><%= f.submit "Зареєструватися", class: "btn btn-primary w-100" %><% end %><p class="mt-4 mb-0">Уже є акаунт? <%= link_to "Увійти", new_session_path(resource_name) %></p></section></div>